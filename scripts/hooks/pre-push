#!/usr/bin/env bash
#
# Pre-push gate. Installed by pointing git at this directory:
#
#     git config core.hooksPath scripts/hooks
#
# It does two things, in this order:
#
#   1. Refuses a push to master unless a human confirms it at the terminal. There is no branch
#      protection on this repository — GitHub blocks it for private repos on the Free plan
#      (verified 2026-08-19: both the protection and the rulesets API answer 403 "Upgrade to
#      GitHub Pro"). This hook is the substitute, so treat a bypass as bypassing branch
#      protection.
#   2. Runs the backend suite against the local ephemeral database, and refuses the push if it
#      fails.
#
# `git push --no-verify` skips all of this. That is git's escape hatch for humans in a hurry,
# not a normal step — and agents must never use it (see AGENTS.md).
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
ZERO="0000000000000000000000000000000000000000"

pushing_master=false
has_content=false

# stdin: <local ref> <local sha> <remote ref> <remote sha>, one line per ref being pushed.
while read -r _local_ref local_sha remote_ref _remote_sha; do
    [[ -z "${remote_ref:-}" ]] && continue
    if [[ "$local_sha" == "$ZERO" ]]; then
        continue  # deleting a remote branch; nothing to test
    fi
    has_content=true
    if [[ "$remote_ref" == "refs/heads/master" ]]; then
        pushing_master=true
    fi
done

if [[ "$has_content" != true ]]; then
    exit 0
fi

if [[ "$pushing_master" == true ]]; then
    echo
    echo "  ╔═══════════════════════════════════════════════════════════════════════════╗"
    echo "  ║  PUSHING STRAIGHT TO MASTER                                               ║"
    echo "  ╚═══════════════════════════════════════════════════════════════════════════╝"
    echo
    echo "  master deploys. A push here runs .github/workflows/deploy.yml, and a green run"
    echo "  ships to https://fpl-assistant.fly.dev — no review, no second pair of eyes."
    echo
    echo "  The normal route is a branch and a pull request: the same tests run there, and"
    echo "  nothing reaches production until the PR is merged."
    echo
    # Only a real terminal gets to confirm. A push driven by an agent or a script has neither
    # stdout nor stderr on a tty, and must be refused rather than left waiting on a prompt
    # nobody will answer.
    if [[ ! -t 1 && ! -t 2 ]]; then
        echo "  Refusing: no terminal to confirm at. If you are an agent, you must not push to"
        echo "  master at all — push a branch and open a pull request instead."
        echo
        exit 1
    fi
    printf "  Type exactly 'push to master' to continue: "
    read -r -t 120 answer < /dev/tty || answer=""
    if [[ "$answer" != "push to master" ]]; then
        echo "  Aborted."
        echo
        exit 1
    fi
    echo
fi

echo "pre-push: running the backend suite against a fresh local test database..."

ENV_FILE="$REPO_ROOT/backend/.env.test"
SCHEMA="$REPO_ROOT/backend/src/test/resources/db/shared-stats-schema.sql"

if [[ ! -f "$ENV_FILE" ]]; then
    echo "pre-push: backend/.env.test is missing." >&2
    echo "          Copy backend/.env.test.example and fill in OPENAI_API_KEY (the RAG tests" >&2
    echo "          embed for real and fail with 401 without it)." >&2
    exit 1
fi

# These must come from .env.test, not from a production environment inherited by the hook.
unset DATABASE_URL DB_USER DB_PASSWORD
set -a
# shellcheck disable=SC1091
source "$ENV_FILE"
set +a
for variable in DATABASE_URL DB_USER DB_PASSWORD; do
    if [[ -z "${!variable:-}" ]]; then
        echo "pre-push: $variable must be set explicitly in backend/.env.test." >&2
        exit 1
    fi
done

if [[ -n "${SPRING_DATASOURCE_URL:-}" || -n "${SPRING_DATASOURCE_USERNAME:-}" \
        || -n "${SPRING_DATASOURCE_PASSWORD:-}" ]]; then
    echo "pre-push: refusing competing SPRING_DATASOURCE_* settings; the test destination" >&2
    echo "          must come only from backend/.env.test." >&2
    exit 1
fi

PORT="${TEST_DB_PORT:-55432}"
if [[ ! "$PORT" =~ ^[0-9]+$ ]] || (( 10#$PORT < 1 || 10#$PORT > 65535 )); then
    echo "pre-push: TEST_DB_PORT must be a valid local TCP port." >&2
    exit 1
fi
if [[ "$DATABASE_URL" != "jdbc:postgresql://localhost:$PORT/postgres" \
        && "$DATABASE_URL" != "jdbc:postgresql://127.0.0.1:$PORT/postgres" ]]; then
    echo "pre-push: DATABASE_URL must identify the disposable local test database as" >&2
    echo "          jdbc:postgresql://localhost:<TEST_DB_PORT>/postgres (127.0.0.1 is also allowed)." >&2
    exit 1
fi
if [[ "$DB_USER" != postgres || "$DB_PASSWORD" != postgres ]]; then
    echo "pre-push: DB_USER and DB_PASSWORD must match the local test fixture credentials." >&2
    exit 1
fi
if [[ ! -r "$SCHEMA" ]]; then
    echo "pre-push: test schema is missing or unreadable: backend/src/test/resources/db/shared-stats-schema.sql" >&2
    exit 1
fi

if ! command -v docker >/dev/null 2>&1; then
    echo "pre-push: docker not found, so the test database cannot be reset." >&2
    exit 1
fi
if [[ -n "${DOCKER_CONTEXT:-}" ]]; then
    if ! DOCKER_ENDPOINT="$(docker context inspect "$DOCKER_CONTEXT" --format '{{ (index .Endpoints "docker").Host }}' 2>/dev/null)"; then
        echo "pre-push: the selected Docker context could not be inspected; no test database was changed." >&2
        exit 1
    fi
elif [[ -n "${DOCKER_HOST:-}" ]]; then
    DOCKER_ENDPOINT="$DOCKER_HOST"
elif ! DOCKER_ENDPOINT="$(docker context inspect --format '{{ (index .Endpoints "docker").Host }}' 2>/dev/null)"; then
    echo "pre-push: the active Docker context could not be inspected; no test database was changed." >&2
    exit 1
fi
case "$DOCKER_ENDPOINT" in
    unix://*|npipe://*) ;;
    *)
        echo "pre-push: refusing a nonlocal Docker context; reset is only safe on a local daemon." >&2
        exit 1
        ;;
esac
if ! docker info >/dev/null 2>&1; then
    echo "pre-push: the Docker daemon is unavailable; no test database was changed." >&2
    exit 1
fi

# Catch regressions in this destructive gate before it resets the real local fixture.
bash "$REPO_ROOT/scripts/tests/pre-push-test.sh"
"$REPO_ROOT/scripts/test-db.sh" reset > /dev/null

# SDKMAN puts java on the PATH from ~/.zshrc, which this non-interactive shell does not read.
if [[ -f "$HOME/.sdkman/bin/sdkman-init.sh" ]]; then
    # set +eu around it: sdkman-init.sh reads ZSH_VERSION unguarded, which `set -u` treats as
    # an error and kills the hook before a single test runs.
    set +eu
    # shellcheck disable=SC1091
    source "$HOME/.sdkman/bin/sdkman-init.sh"
    set -eu
fi

cd "$REPO_ROOT/backend"

# cleanTest, because Gradle reports BUILD SUCCESSFUL without running anything when the task is
# up to date — a green that proves nothing is worse than no check at all.
if ! ./gradlew --console=plain --quiet cleanTest test; then
    echo >&2
    echo "pre-push: tests failed — push refused." >&2
    exit 1
fi

echo "pre-push: suite green."
