#!/usr/bin/env bash
#
# Pre-push gate. Installed by pointing git at this directory:
#
#     git config core.hooksPath scripts/hooks
#
# It refuses a push to master unless a human confirms it at the terminal. There is no branch
# protection on this repository — GitHub blocks it for private repos on the Free plan (verified
# 2026-08-19: both the protection and the rulesets API answer 403 "Upgrade to GitHub Pro"). This
# hook is the substitute, so treat a bypass as bypassing branch protection.
#
# It does not run the suite. It did until 2026-09-19; a six-minute Gradle run on every push was
# too heavy for the cloud host this is also developed on. New tests are run while developing,
# and the whole suite runs on GitHub for every pull request and again on the merge to master.
# The hook needs nothing but bash and git, so it installs on every host.
#
# `git push --no-verify` skips all of this. That is git's escape hatch for humans in a hurry,
# not a normal step — and agents must never use it (see AGENTS.md).
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
ZERO="0000000000000000000000000000000000000000"

pushing_master=false
has_content=false

# stdin: <local ref> <local sha> <remote ref> <remote sha>, one line per ref being pushed.
while read -r _local_ref local_sha remote_ref _remote_sha; do
    [[ -z "${remote_ref:-}" ]] && continue
    if [[ "$local_sha" == "$ZERO" ]]; then
        continue  # deleting a remote branch; nothing to guard
    fi
    has_content=true
    if [[ "$remote_ref" == "refs/heads/master" ]]; then
        pushing_master=true
    fi
done

if [[ "$has_content" != true ]]; then
    exit 0
fi

if [[ "$pushing_master" == true ]]; then
    echo
    echo "  ╔═══════════════════════════════════════════════════════════════════════════╗"
    echo "  ║  PUSHING STRAIGHT TO MASTER                                               ║"
    echo "  ╚═══════════════════════════════════════════════════════════════════════════╝"
    echo
    echo "  master deploys. A push here runs .github/workflows/deploy.yml, and a green run"
    echo "  ships to https://fpl-assistant.fly.dev — no review, no second pair of eyes."
    echo
    echo "  The normal route is a branch and a pull request: the same tests run there, and"
    echo "  nothing reaches production until the PR is merged."
    echo
    # Only a real terminal gets to confirm. A push driven by an agent or a script has neither
    # stdout nor stderr on a tty, and must be refused rather than left waiting on a prompt
    # nobody will answer.
    if [[ ! -t 1 && ! -t 2 ]]; then
        echo "  Refusing: no terminal to confirm at. If you are an agent, you must not push to"
        echo "  master at all — push a branch and open a pull request instead."
        echo
        exit 1
    fi
    printf "  Type exactly 'push to master' to continue: "
    read -r -t 120 answer < /dev/tty || answer=""
    if [[ "$answer" != "push to master" ]]; then
        echo "  Aborted."
        echo
        exit 1
    fi
    echo
fi
