# Copy to .env.local (gitignored) for local work. The publishable key is safe to ship in a
# bundle but is deliberately not committed — see frontend/src/auth/supabaseClient.ts.
# Read it from the Supabase dashboard: Project Settings → API Keys → publishable key.
VITE_SUPABASE_ANON_KEY=

# These values are public in the deployed privacy notice, but are not stored in Git.
VITE_PRIVACY_CONTROLLER_NAME=
VITE_PRIVACY_CONTACT_EMAIL=

# Required. Use the same project as the backend's SUPABASE_URL.
VITE_SUPABASE_URL=https://your-project.supabase.co
