{
  "name": "fpl-assistant-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:prod": "FPL_API_PROXY=https://fpl-assistant.fly.dev vite",
    "build": "npm run check-contrast && tsc -b && vite build",
    "preview": "vite preview",
    "check-contrast": "node scripts/check-contrast.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-table": "^8.21.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@eslint/js": "10.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "10.10.0",
    "eslint-plugin-sonarjs": "4.2.1",
    "eslint-plugin-unicorn": "75.0.0",
    "jsdom": "^27.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.11"
  }
}
