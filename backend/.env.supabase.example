# Copy to backend/.env.supabase and fill in the password. .env.supabase is gitignored.
#
# These are the PRODUCTION credentials. Tests do not use them and must not: the suite runs
# against a disposable container (see backend/.env.test.example and scripts/test-db.sh), and
# SharedStatsSeed refuses to seed a database that carries the upstream project’s own tables.
#
# What still needs them:
#   scripts/dump-test-schema.sh            # regenerate / --check the shared schema dump
#   ./gradlew bootRun --args="--ingest"    # reload the production RAG corpus
#   ./gradlew bootRun --args="--backfill"  # historical backfill
#   ./gradlew bootRun --args="--sync-prices"
#
# Load with `set -a; source`, never `export $(cat ... | xargs)` — the JDBC URL contains
# characters the latter mangles.
#
# Copy your project's transaction-pooler host and username from the Supabase dashboard.
# Port 6543 is the transaction pooler; port 5432 is the session pooler used for schema dumps.
# The pooler username includes your project ref, not just postgres.
#
# scripts/dump-test-schema.sh connects on 5432 instead — the SESSION pooler. pg_dump needs a
# session and cannot run through the transaction pooler.
#
# Keep the URL free of `&` — an unquoted `&` breaks `set -a; source` too. That is why
# prepareThreshold=0 (required by the transaction pooler) lives in application.yml under hikari
# data-source-properties, not in this URL.
DATABASE_URL=jdbc:postgresql://your-pooler-host:6543/postgres?sslmode=require
SHARED_DB_HOST=your-pooler-host
DB_USER=postgres.your-project-ref
DB_PASSWORD=

# Supabase Auth: the project URL, used to verify JWT signatures against the project's JWKS.
SUPABASE_URL=https://your-project.supabase.co

# Creates accounts for POST /api/auth/signup through Supabase's Admin API. It BYPASSES row-level
# security entirely — handle it like the database password: backend only, never logged, never in
# anything the frontend build can reach. Project Settings -> API -> service_role. Leave it empty
# and sign-up is closed, which is the safe default rather than a failure.
SUPABASE_SERVICE_ROLE_KEY=

# The shared invite code sign-up asks for, and the hard ceiling on how many accounts it can
# create. An unset code refuses every sign-up. The cap is what the free tier's cost ceiling is
# drawn against (30 accounts x 20 messages a week is about EUR 38/month).
INVITE_CODE=
INVITE_MAX_ACCOUNTS=30

# Who may call the admin API (/api/admin/**): JWT sub ids, comma-separated. The owner's sub is
# the id column in Supabase -> Authentication -> Users. Empty means nobody, which closes the
# admin API rather than opening it. Set in production with `fly secrets set ADMIN_USER_IDS=…`.
ADMIN_USER_IDS=

SPRING_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
FOOTBALL_DATA_API_KEY=

# Assistant-owned core sync remains inert until the reviewed single-writer cutover.
OWNED_SYNC_MODE=OFF
OWNED_SYNC_PLAYING_SEASON=
OWNED_SYNC_CUTOVER_CONFIRMED=false

# Task 8 owner operations/monitoring. Leave disabled and blank until the owner selects and
# verifies destinations. Tokens and webhook URLs are secrets; never commit real values here.
# Uptime Kuma alternative: enable authenticated external health and select this instead of webhook.
OWNED_SYNC_ALERTS_VIA_MONITOR=false
OWNED_SYNC_ALERT_WEBHOOK_ENABLED=false
OWNED_SYNC_ALERT_WEBHOOK_URL=
OWNED_SYNC_OPS_ENABLED=false
OWNED_SYNC_OPERATOR_TOKEN=
OWNED_SYNC_EXTERNAL_HEALTH_ENABLED=false
OWNED_SYNC_MONITOR_TOKEN=
