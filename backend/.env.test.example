# Copy to backend/.env.test and fill in the secrets. .env.test is gitignored.
#
# Load it before running Gradle:
#   set -a; source .env.test; set +a
#
# Use `set -a; source` rather than `export $(cat .env.test | xargs)` — the latter
# backgrounds on `&` in the JDBC URL and mangles it.

# Supabase project: tapas-and-tackles (ref itmykooxrbrdbgqwsesb, eu-west-1)
#
# Transaction pooler (port 6543) is the default choice: the direct host
# db.itmykooxrbrdbgqwsesb.supabase.co is IPv6-only, which most WSL2 setups
# cannot reach. The pooler username is postgres.<project-ref>, NOT plain postgres.
#
# This project lives on aws-1; aws-0 answers "FATAL: (ENOTFOUND) tenant/user
# ... not found", which means wrong pooler, not wrong password.
DATABASE_URL=jdbc:postgresql://aws-1-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require
DB_USER=postgres.itmykooxrbrdbgqwsesb
DB_PASSWORD=

# LLM provider: anthropic (default) or openai
SPRING_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
