# Copy to backend/.env.test and fill in OPENAI_API_KEY. .env.test is gitignored.
#
# Load it before running Gradle:
#   set -a; source .env.test; set +a
#
# Use `set -a; source` rather than `export $(cat .env.test | xargs)` — the latter
# backgrounds on `&` in the JDBC URL and mangles it.

# The test database is the local container from scripts/test-db.sh: created empty, thrown away,
# nothing persisting between runs. Start it with `scripts/test-db.sh up` (or `reset`).
#
# It is NOT Supabase, deliberately. Tests seed the data they assert on (TapasSeed), which means
# writing to tapas-owned tables — forbidden on the shared database, and TapasSeed refuses to run
# there. Production credentials now live in backend/.env.supabase; see that template.
DATABASE_URL=jdbc:postgresql://localhost:55432/postgres
DB_USER=postgres
DB_PASSWORD=postgres

# No test calls a chat model, but the autoconfiguration needs a non-empty key to start.
SPRING_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=not-used-no-test-calls-a-chat-model

# Real, and genuinely used: IngestionIntegrationTest and StrategyToolsIntegrationTest embed for
# real. With a dummy value they fail on "401: Incorrect API key provided".
OPENAI_API_KEY=

# Deliberately empty: the football-data sync logs and no-ops without a key, which is what the
# tests expect. The startup syncs are off under the test profile anyway.
FOOTBALL_DATA_API_KEY=
