# Copy to backend/.env.test and fill in the secrets. .env.test is gitignored.
#
# Load it before running Gradle:
#   set -a; source .env.test; set +a
#
# Use `set -a; source` rather than `export $(cat .env.test | xargs)` — the latter
# backgrounds on `&` in the JDBC URL and mangles it.

# Supabase project: example-project (ref example-project, eu-west-1)
#
# Transaction pooler (port 6543) is the default choice: the direct host
# db.example-project.supabase.co is IPv6-only, which most WSL2 setups
# cannot reach. The pooler username is postgres.<project-ref>, NOT plain postgres.
#
# This project lives on aws-1; aws-0 answers "FATAL: (ENOTFOUND) tenant/user
# ... not found", which means wrong pooler, not wrong password.
#
# Keep the URL free of `&` — an unquoted `&` breaks `set -a; source` too. That is
# why prepareThreshold=0 (required by the transaction pooler) lives in
# application.yml under hikari data-source-properties, not in this URL.
DATABASE_URL=jdbc:postgresql://aws-1-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require
DB_USER=postgres.example-project
DB_PASSWORD=

# LLM provider: anthropic (default) or openai
SPRING_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Phase 3: keeps the in-progress season current (StartupSyncRunner, on app startup).
# Free registration at https://www.football-data.org/client/register. Verified against the
# live API 2026-08-15 (FootballDataCapturedResponseTest); sync is a silent no-op without
# this key (logged, does not fail startup).
FOOTBALL_DATA_API_KEY=
