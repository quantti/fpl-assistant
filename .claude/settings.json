{
  "permissions": {
    "ask": [
      "Bash(fly deploy:*)",
      "Bash(flyctl deploy:*)",
      "Bash(fly apps destroy:*)",
      "Bash(flyctl apps destroy:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/ask-before-deploy.sh\"",
            "statusMessage": "Checking for a production deploy"
          }
        ]
      }
    ]
  }
}
